import Base.Order.Defs.PartialOrder
import Base.Order.Notation

/-! # Lattices

Mathlib: `Mathlib/Order/Defs/Lattice.lean`.

A lattice is a partial order where any two elements have a least upper bound `a ⊔ b` (join)
and a greatest lower bound `a ⊓ b` (meet). Examples: sets (`∪`, `∩`), subgroups (`H ⊔ K`, the
subgroup generated by both, and `H ⊓ K`, the intersection).

Mathlib's `SemilatticeSup` has a field `sup` and derives `Max` from it; here the classes extend
core's `Max` and `Min` directly (not in Mathlib), so existing `⊔`/`⊓` instances plug in. The
fields are the universal property; everything below follows from them. -/

universe u

namespace My

class SemilatticeSup (α : Type u) extends PartialOrder α, Max α where
  protected le_sup_left : ∀ a b : α, a ≤ a ⊔ b
  protected le_sup_right : ∀ a b : α, b ≤ a ⊔ b
  protected sup_le : ∀ a b c : α, a ≤ c → b ≤ c → a ⊔ b ≤ c

class SemilatticeInf (α : Type u) extends PartialOrder α, Min α where
  protected inf_le_left : ∀ a b : α, a ⊓ b ≤ a
  protected inf_le_right : ∀ a b : α, a ⊓ b ≤ b
  protected le_inf : ∀ a b c : α, a ≤ b → a ≤ c → a ≤ b ⊓ c

class Lattice (α : Type u) extends SemilatticeSup α, SemilatticeInf α

section SemilatticeSup

variable {α : Type u} [SemilatticeSup α] {a b c : α}

theorem le_sup_left : a ≤ a ⊔ b :=
  sorry

theorem le_sup_right : b ≤ a ⊔ b :=
  sorry

theorem sup_le : a ≤ c → b ≤ c → a ⊔ b ≤ c :=
  sorry

-- the universal property as one equivalence
theorem sup_le_iff : a ⊔ b ≤ c ↔ a ≤ c ∧ b ≤ c :=
  sorry

theorem sup_idem (a : α) : a ⊔ a = a :=
  sorry

theorem sup_comm (a b : α) : a ⊔ b = b ⊔ a :=
  sorry

theorem sup_assoc (a b c : α) : a ⊔ b ⊔ c = a ⊔ (b ⊔ c) :=
  sorry

end SemilatticeSup

section SemilatticeInf

variable {α : Type u} [SemilatticeInf α] {a b c : α}

theorem inf_le_left : a ⊓ b ≤ a :=
  sorry

theorem inf_le_right : a ⊓ b ≤ b :=
  sorry

theorem le_inf : a ≤ b → a ≤ c → a ≤ b ⊓ c :=
  sorry

theorem le_inf_iff : a ≤ b ⊓ c ↔ a ≤ b ∧ a ≤ c :=
  sorry

theorem inf_idem (a : α) : a ⊓ a = a :=
  sorry

theorem inf_comm (a b : α) : a ⊓ b = b ⊓ a :=
  sorry

theorem inf_assoc (a b c : α) : a ⊓ b ⊓ c = a ⊓ (b ⊓ c) :=
  sorry

end SemilatticeInf

/-! ### Distributive lattices

`⊓` distributes over `⊔` (and then `⊔` over `⊓`). Sets are distributive; subgroups are not in
general. The field is the one inequality that doesn't hold in every lattice; the other half,
and the equations, follow. -/

class DistribLattice (α : Type u) extends Lattice α where
  protected le_sup_inf : ∀ x y z : α, (x ⊔ y) ⊓ (x ⊔ z) ≤ x ⊔ y ⊓ z

section DistribLattice

variable {α : Type u} [DistribLattice α]

theorem sup_inf_left (a b c : α) : a ⊔ b ⊓ c = (a ⊔ b) ⊓ (a ⊔ c) :=
  sorry

theorem inf_sup_left (a b c : α) : a ⊓ (b ⊔ c) = a ⊓ b ⊔ a ⊓ c :=
  sorry

end DistribLattice

end My

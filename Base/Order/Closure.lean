import Base.Order.Hom.Basic
import Base.Order.GaloisConnection.Defs

/-! # Closure operators

Mathlib: `Mathlib/Order/Closure.lean`.

A closure operator is a monotone `c : α → α` with `x ≤ c x` and `c (c x) = c x`. One
abstraction covers `Subgroup.closure` (read in `Set G`), the closure of a set in topology, the
span of vectors, the ideal generated by elements, and the normal closure: "the smallest closed
thing containing `x`".

Every Galois connection `l ⊣ u` gives one, `u ∘ l` (`GaloisConnection.closureOperator`): for
subgroups, `l` is `closure` and `u` the carrier. Mathlib's structure also carries an
`IsClosed` predicate with a default value; it is left out here. -/

universe u v

namespace My

structure ClosureOperator (α : Type u) [Preorder α] extends α →o α where
  le_closure' : ∀ x, x ≤ toFun x
  idempotent' : ∀ x, toFun (toFun x) = toFun x

namespace ClosureOperator

variable {α : Type u} [PartialOrder α] (c : ClosureOperator α)

instance : CoeFun (ClosureOperator α) (λ _ => α → α) :=
  sorry

theorem ext (c₁ c₂ : ClosureOperator α) (h : ∀ x, c₁ x = c₂ x) : c₁ = c₂ :=
  sorry

theorem monotone : Monotone c :=
  sorry

theorem le_closure (x : α) : x ≤ c x :=
  sorry

theorem idempotent (x : α) : c (c x) = c x :=
  sorry

-- the universal property: `x` is below the closure of `y` iff its closure is
theorem le_closure_iff {x y : α} : x ≤ c y ↔ c x ≤ c y :=
  sorry

-- the identity is a closure operator (everything is closed)
protected def id (α : Type u) [PartialOrder α] : ClosureOperator α :=
  sorry

end ClosureOperator

-- `u ∘ l` is a closure operator on `α`
def GaloisConnection.closureOperator {α : Type u} {β : Type v} [PartialOrder α] [Preorder β]
    {l : α → β} {u : β → α} (gc : GaloisConnection l u) : ClosureOperator α :=
  sorry

theorem GaloisConnection.closureOperator_apply {α : Type u} {β : Type v} [PartialOrder α]
    [Preorder β] {l : α → β} {u : β → α} (gc : GaloisConnection l u) (x : α) :
    gc.closureOperator x = u (l x) :=
  sorry

end My

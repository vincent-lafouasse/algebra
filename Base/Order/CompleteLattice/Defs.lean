import Base.Order.Lattice
import Base.Data.Set

/-! # Complete lattices

Mathlib: `Mathlib/Order/SetNotation.lean` (`SupSet`, `InfSet`),
`Mathlib/Order/CompleteLattice/Defs.lean`, `Mathlib/Order/BoundedOrder/Basic.lean` (`le_top`,
`bot_le`).

A complete lattice has a least upper bound `sSup s` and a greatest lower bound `sInf s` for
every *set* `s` of elements, not just for pairs, and so a top `⊤` and a bottom `⊥`. Examples:
`Set α` (union and intersection of a family), `Subgroup G` (`sInf` is the intersection; `sSup`
is the subgroup generated by the union).

Mathlib states the fields through `IsLUB`/`IsGLB` and `BoundedOrder`; here they are the six
inequalities directly (not in Mathlib). -/

universe u

namespace My

class SupSet (α : Type u) where
  sSup : Set α → α

class InfSet (α : Type u) where
  sInf : Set α → α

export SupSet (sSup)
export InfSet (sInf)

class CompleteLattice (α : Type u) extends Lattice α, SupSet α, InfSet α, Top α, Bot α where
  protected le_sSup : ∀ (s : Set α) (a : α), a ∈ s → a ≤ sSup s
  protected sSup_le : ∀ (s : Set α) (a : α), (∀ b ∈ s, b ≤ a) → sSup s ≤ a
  protected sInf_le : ∀ (s : Set α) (a : α), a ∈ s → sInf s ≤ a
  protected le_sInf : ∀ (s : Set α) (a : α), (∀ b ∈ s, a ≤ b) → a ≤ sInf s
  protected le_top : ∀ a : α, a ≤ ⊤
  protected bot_le : ∀ a : α, ⊥ ≤ a

variable {α : Type u} [CompleteLattice α] {s : Set α} {a : α}

theorem le_sSup (h : a ∈ s) : a ≤ sSup s :=
  sorry

theorem sSup_le (h : ∀ b ∈ s, b ≤ a) : sSup s ≤ a :=
  sorry

theorem sInf_le (h : a ∈ s) : sInf s ≤ a :=
  sorry

theorem le_sInf (h : ∀ b ∈ s, a ≤ b) : a ≤ sInf s :=
  sorry

theorem le_top : a ≤ ⊤ :=
  sorry

theorem bot_le : ⊥ ≤ a :=
  sorry

-- the universal properties as equivalences
theorem sSup_le_iff : sSup s ≤ a ↔ ∀ b ∈ s, b ≤ a :=
  sorry

theorem le_sInf_iff : a ≤ sInf s ↔ ∀ b ∈ s, a ≤ b :=
  sorry

end My

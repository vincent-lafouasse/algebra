/-! # Order notation

Mathlib: `Mathlib/Order/Notation.lean`.

`⊥` and `⊤` (the smallest and largest element), `⊓` (meet, for subgroups: intersection) and
`⊔` (join, for subgroups: the subgroup generated by both), `ᶜ` (complement).
Core Lean has `LE` for `≤`, `Min` for `min` and `Max` for `max`; `⊓` is notation for `min`
and `⊔` for `max`, as in Mathlib. -/

universe u

namespace My

class Bot (α : Type u) where
  bot : α

class Top (α : Type u) where
  top : α

notation "⊥" => Bot.bot

notation "⊤" => Top.top

-- complement: `sᶜ` for sets, `xᶜ` in a Boolean algebra (typed `\^c`)
class Compl (α : Type u) where
  compl : α → α

export Compl (compl)

postfix:1024 "ᶜ" => compl

end My

infixl:69 " ⊓ " => Min.min

infixl:68 " ⊔ " => Max.max

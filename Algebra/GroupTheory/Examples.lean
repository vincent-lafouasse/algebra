import Algebra.GroupTheory.QuotientGroup.Basic
import Algebra.Group.TypeTags.Basic

/-! # Small concrete groups (not in Mathlib as a file)

A few groups to compute with, and the whole quotient stack on one concrete case:

- the trivial group `PUnit` (Mathlib: `PUnit.commGroup`, in `Mathlib/Algebra/Group/PUnit.lean`);
- `Bool` under `xor` (not in Mathlib: there it would be `Multiplicative (ZMod 2)`). Its
  instances are `scoped`: they only exist after `open My.BoolXor`, so `Bool` gets no `*`
  anywhere else;
- `ℤ ⧸ 2ℤ`, inside `Multiplicative ℤ`: two classes, the evens and the odds, and the first
  isomorphism theorem for parity `ℤ → Bool` gives `ℤ ⧸ 2ℤ ≃* Bool`. -/

universe u

namespace My

/-! ### The trivial group -/

instance : Mul PUnit.{u + 1} :=
  ⟨λ _ _ => PUnit.unit⟩

instance : One PUnit.{u + 1} :=
  ⟨PUnit.unit⟩

instance : Inv PUnit.{u + 1} :=
  ⟨λ _ => PUnit.unit⟩

instance PUnit.commGroup : CommGroup PUnit.{u + 1} :=
  { Group.ofLeftAxioms sorry sorry sorry with mul_comm := sorry }

/-! ### `Bool` under `xor` -/

namespace BoolXor

scoped instance : Mul Bool :=
  ⟨xor⟩

scoped instance : One Bool :=
  ⟨false⟩

-- every element is its own inverse
scoped instance : Inv Bool :=
  ⟨λ b => b⟩

scoped instance commGroup : CommGroup Bool :=
  { Group.ofLeftAxioms sorry sorry sorry with mul_comm := sorry }

end BoolXor

/-! ### `ℤ ⧸ 2ℤ` -/

namespace Multiplicative

open Multiplicative

/-- `2ℤ`, the even integers, as the subgroup generated by `2` in `Multiplicative ℤ`. -/
def twoZ : Subgroup (Multiplicative Int) :=
  Subgroup.zpowers (ofAdd 2)

-- (Mathlib: `Int.mem_zmultiples_iff`, for `AddSubgroup.zmultiples`)
theorem mem_twoZ_iff {n : Multiplicative Int} : n ∈ twoZ ↔ (2 : Int) ∣ toAdd n :=
  sorry

-- a commutative group: every subgroup is normal
instance : twoZ.Normal :=
  sorry

-- two integers have the same class mod 2 exactly when their difference is even
theorem mk_eq_mk_iff_two_dvd {a b : Int} :
    ((ofAdd a : Multiplicative Int) : Multiplicative Int ⧸ twoZ) = (ofAdd b : Multiplicative Int) ↔
      (2 : Int) ∣ b - a :=
  sorry

-- exactly two classes: the evens and the odds
theorem eq_zero_or_eq_one (q : Multiplicative Int ⧸ twoZ) :
    q = ((ofAdd 0 : Multiplicative Int) : Multiplicative Int ⧸ twoZ) ∨
      q = ((ofAdd 1 : Multiplicative Int) : Multiplicative Int ⧸ twoZ) :=
  sorry

open BoolXor

/-- Parity, `ℤ → Bool`, as a hom: `true` for odd integers. -/
def parity : Multiplicative Int →* Bool where
  toFun n := decide (toAdd n % 2 = 1)
  map_one' := sorry
  map_mul' := sorry

theorem ker_parity : parity.ker = twoZ :=
  sorry

theorem parity_surjective : Function.Surjective parity :=
  sorry

/-- The first isomorphism theorem for parity. -/
noncomputable def quotientTwoZEquivBool : Multiplicative Int ⧸ twoZ ≃* Bool :=
  sorry

end Multiplicative

end My

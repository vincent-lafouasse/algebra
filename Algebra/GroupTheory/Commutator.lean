import Algebra.Notation.Bracket
import Algebra.Group.Subgroup.Basic
import Algebra.GroupTheory.Centralizer
import Algebra.GroupTheory.Center

/-! # Commutators

Mathlib: `Mathlib/Algebra/Group/Commutator.lean` (elements),
`Mathlib/GroupTheory/Commutator/Basic.lean` (subgroups).

`⁅g, h⁆ = g * h * g⁻¹ * h⁻¹` measures how far `g` and `h` are from commuting: it is `1` exactly
when they commute. `⁅H, K⁆` is the subgroup generated by all `⁅h, k⁆`, and
`commutator G = ⁅⊤, ⊤⁆` (also written `G'`) is the smallest normal subgroup with an abelian
quotient: see `Abelianization.lean`.

Mathlib's element instance is scoped (`open scoped commutatorElement`), so that it does not
clash with the Lie bracket of a ring; here it is global for now. -/

universe u v

namespace My

variable {G : Type u} [Group G]

/-! ### Commutators of elements -/

instance commutatorElement : Bracket G G :=
  sorry

theorem commutatorElement_def (g₁ g₂ : G) : ⁅g₁, g₂⁆ = g₁ * g₂ * g₁⁻¹ * g₂⁻¹ :=
  sorry

theorem commutatorElement_eq_one_iff_mul_comm {g₁ g₂ : G} : ⁅g₁, g₂⁆ = 1 ↔ g₁ * g₂ = g₂ * g₁ :=
  sorry

theorem commutatorElement_one_right (g : G) : ⁅g, (1 : G)⁆ = 1 :=
  sorry

theorem commutatorElement_one_left (g : G) : ⁅(1 : G), g⁆ = 1 :=
  sorry

theorem commutatorElement_self (g : G) : ⁅g, g⁆ = 1 :=
  sorry

theorem commutatorElement_inv (g₁ g₂ : G) : ⁅g₁, g₂⁆⁻¹ = ⁅g₂, g₁⁆ :=
  sorry

theorem map_commutatorElement {G' : Type v} [Group G'] (f : G →* G') (g₁ g₂ : G) :
    f ⁅g₁, g₂⁆ = ⁅f g₁, f g₂⁆ :=
  sorry

/-! ### Commutators of subgroups -/

namespace Subgroup

instance commutator : Bracket (Subgroup G) (Subgroup G) :=
  sorry

theorem commutator_def (H₁ H₂ : Subgroup G) :
    ⁅H₁, H₂⁆ = closure {g | ∃ g₁ ∈ H₁, ∃ g₂ ∈ H₂, ⁅g₁, g₂⁆ = g} :=
  sorry

variable {g₁ g₂ : G} {H₁ H₂ H₃ K₁ K₂ : Subgroup G}

theorem commutator_mem_commutator (h₁ : g₁ ∈ H₁) (h₂ : g₂ ∈ H₂) : ⁅g₁, g₂⁆ ∈ ⁅H₁, H₂⁆ :=
  sorry

-- the universal property, as for `closure_le`
theorem commutator_le : ⁅H₁, H₂⁆ ≤ H₃ ↔ ∀ g₁ ∈ H₁, ∀ g₂ ∈ H₂, ⁅g₁, g₂⁆ ∈ H₃ :=
  sorry

theorem commutator_mono (h₁ : H₁ ≤ K₁) (h₂ : H₂ ≤ K₂) : ⁅H₁, H₂⁆ ≤ ⁅K₁, K₂⁆ :=
  sorry

theorem commutator_comm (H₁ H₂ : Subgroup G) : ⁅H₁, H₂⁆ = ⁅H₂, H₁⁆ :=
  sorry

theorem commutator_eq_bot_iff_le_centralizer : ⁅H₁, H₂⁆ = ⊥ ↔ H₁ ≤ centralizer (H₂ : Set G) :=
  sorry

instance commutator_normal [H₁.Normal] [H₂.Normal] : (⁅H₁, H₂⁆ : Subgroup G).Normal :=
  sorry

theorem commutator_le_inf [H₁.Normal] [H₂.Normal] : ⁅H₁, H₂⁆ ≤ H₁ ⊓ H₂ :=
  sorry

theorem map_commutator {G' : Type v} [Group G'] (f : G →* G') (H₁ H₂ : Subgroup G) :
    map f ⁅H₁, H₂⁆ = ⁅map f H₁, map f H₂⁆ :=
  sorry

end Subgroup

/-! ### The commutator subgroup `G'` -/

def commutator (G : Type u) [Group G] : Subgroup G :=
  sorry

theorem commutator_def : commutator G = ⁅(⊤ : Subgroup G), ⊤⁆ :=
  sorry

-- (Mathlib gets it from `Subgroup.commutator_normal`, through `commutator_def`)
instance commutator_normal : (commutator G).Normal :=
  sorry

-- any subgroup containing `G'` is normal (`My.`: inside `Subgroup`, `commutator` is the instance)
theorem Subgroup.Normal.of_commutator_le {H : Subgroup G} (h : My.commutator G ≤ H) :
    H.Normal :=
  sorry

theorem commutator_eq_bot_iff_center_eq_top : commutator G = ⊥ ↔ Subgroup.center G = ⊤ :=
  sorry

end My

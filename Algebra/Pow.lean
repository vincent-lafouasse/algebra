import Algebra.Commute

/-! # Powers

`g ^ n` for `n : Nat` by recursion, then `g ^ k` for `k : Int` by cases. Every lemma
about `Nat` powers is an induction on `n`; the `Int` ones split on the two constructors
`Int.ofNat n` (k ≥ 0) and `Int.negSucc n` (k = -(n+1)). -/

universe u v

namespace My

open Group

namespace Group

variable {G : Type u} [Group G]

/-! ### Natural powers -/

-- g ^ 0 = one, g ^ (n+1) = g * g ^ n
def npow : Nat → G → G
  | 0, _ => one
  | n + 1, g => g * npow n g

instance : Pow G Nat := ⟨λ g n => npow n g⟩

-- the two defining equations, as the API (both `rfl`)
theorem pow_zero (g : G) : g ^ (0 : Nat) = one :=
  rfl

theorem pow_succ (g : G) (n : Nat) : g ^ (n + 1) = g * g ^ n :=
  rfl

theorem pow_one (g : G) : g ^ (1 : Nat) = g := by
  rw [pow_succ g 0]
  rw [pow_zero]
  rw [mul_one]

theorem one_pow (n : Nat) : (one : G) ^ n = one :=
  match n with
  | 0 => by rw [pow_zero]
  | Nat.succ n => by rw [pow_succ]
                     rw [one_mul]
                     exact one_pow n

theorem one_pow' (n : Nat) : (one : G) ^ n = one := by
  induction n with
  | zero => rfl
  | succ n ih => rw [pow_succ, one_mul]; exact ih

-- the other way round: needs induction (and `mul_assoc`)
theorem pow_succ' (g : G) (n : Nat) : g ^ (n + 1) = g ^ n * g := by
  induction n with
  | zero => rw [Nat.add_zero, pow_zero, one_mul, pow_one] 
  | succ n h => rw [pow_succ g (n + 1)]
                conv => lhs; rw [h]
                rw [← mul_assoc]
                rw [← pow_succ]

end Group

/-! ### Commuting with powers -/

namespace Commute

open Group

variable {G : Type u} [Group G] {a b : G}

-- induction on n, with `Commute.mul_left`
theorem pow_left (h : Commute a b) (n : Nat) : Commute (a ^ n) b := by
  induction n with
  | zero => rw [pow_zero a]; exact one_left b
  | succ n h' => rw [pow_succ]; exact mul_left h h'

theorem pow_right (h : Commute a b) (n : Nat) : Commute a (b ^ n) := by
  exact (pow_left h.symm n).symm

theorem pow_pow (h : Commute a b) (m n : Nat) : Commute (a ^ m) (b ^ n) :=
  sorry

-- g commutes with its own powers
theorem self_pow (g : G) (n : Nat) : Commute g (g ^ n) :=
  sorry

-- (ab)^n = a^n b^n needs a and b to commute; false in general (try n = 2)
theorem mul_pow (h : Commute a b) (n : Nat) : (a * b) ^ n = a ^ n * b ^ n :=
  sorry

end Commute

namespace Group

variable {G : Type u} [Group G]

-- induction on m
theorem pow_add (g : G) (m n : Nat) : g ^ (m + n) = g ^ m * g ^ n :=
  sorry

-- induction on n, using `pow_add`
theorem pow_mul (g : G) (m n : Nat) : g ^ (m * n) = (g ^ m) ^ n :=
  sorry

theorem inv_pow (g : G) (n : Nat) : (g⁻¹) ^ n = (g ^ n)⁻¹ :=
  sorry

/-! ### Integer powers -/

-- k ≥ 0: g ^ n; k = -(n+1): (g ^ (n+1))⁻¹
def zpow : Int → G → G
  | Int.ofNat n, g => g ^ n
  | Int.negSucc n, g => (g ^ (n + 1))⁻¹

instance : Pow G Int := ⟨λ g k => zpow k g⟩

-- the defining equations (`rfl`)
theorem zpow_natCast (g : G) (n : Nat) : g ^ (n : Int) = g ^ n :=
  sorry

theorem zpow_negSucc (g : G) (n : Nat) : g ^ (Int.negSucc n) = (g ^ (n + 1))⁻¹ :=
  sorry

theorem zpow_zero (g : G) : g ^ (0 : Int) = one :=
  sorry

theorem zpow_one (g : G) : g ^ (1 : Int) = g :=
  sorry

-- split on k; `-(ofNat (n+1)) = negSucc n` is the Int fact you need
theorem zpow_neg (g : G) (k : Int) : g ^ (-k) = (g ^ k)⁻¹ :=
  sorry

-- stepping stones for `zpow_add`: one more / one less
theorem zpow_add_one (g : G) (k : Int) : g ^ (k + 1) = g ^ k * g :=
  sorry

theorem zpow_sub_one (g : G) (k : Int) : g ^ (k - 1) = g ^ k * g⁻¹ :=
  sorry

-- the hard one: split on the sign of `l`, then induction on its size,
-- moving one factor at a time with the two lemmas above
theorem zpow_add (g : G) (k l : Int) : g ^ (k + l) = g ^ k * g ^ l :=
  sorry

end Group

/-! ### Homs preserve powers -/

namespace Hom

variable {G : Type u} {H : Type v} [Group G] [Group H]

theorem map_pow (f : G →* H) (g : G) (n : Nat) : f (g ^ n) = (f g) ^ n :=
  sorry

theorem map_zpow (f : G →* H) (g : G) (k : Int) : f (g ^ k) = (f g) ^ k :=
  sorry

end Hom

/-! ### The subgroup generated by one element -/

namespace Subgroup

variable {G : Type u} [Group G]

-- ⟨g⟩ = { g ^ k | k : Int }; closure is `zpow_add`, `zpow_neg`, `zpow_zero`
def zpowers (g : G) : Subgroup G where
  mem := λ x => ∃ k : Int, g ^ k = x
  one_mem := sorry
  mul_mem := sorry
  inv_mem := sorry

theorem mem_zpowers_iff (g x : G) : x ∈ zpowers g ↔ ∃ k : Int, g ^ k = x :=
  sorry

theorem mem_zpowers_self (g : G) : g ∈ zpowers g :=
  sorry

-- ⟨g⟩ is the smallest subgroup containing g (state it with `≤` once you have it)
theorem zpowers_le {g : G} {S : Subgroup G} (hg : g ∈ S) : ∀ x, x ∈ zpowers g → x ∈ S :=
  sorry

end Subgroup
end My

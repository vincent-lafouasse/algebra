import Algebra.Group.Hom
import Algebra.Logic.Equiv

/-! # Isomorphisms `G ≃* H`

Mathlib: `Mathlib/Algebra/Group/Equiv/Defs.lean`.

An isomorphism is a bijection `G ≃ H` (with its inverse as data) that preserves `*`.
Mathlib writes `structure MulEquiv extends G ≃ H, MulHom G H`; here it extends `G ≃ H` only.
(Extending our `MonoidHom` would add a `map_one'` field, which follows from `map_mul'`: that
is why Mathlib extends `MulHom`, the hom without it, which we don't have.)

`extends` generates `toEquiv`, and `e.toFun` is `e.toEquiv.toFun` (there is no constant
`MulEquiv.toFun`). `toMonoidHom` is built by hand. -/

universe u v w

namespace My

structure MulEquiv (G : Type u) (H : Type v) [Group G] [Group H] extends G ≃ H where
  map_mul' : ∀ x y : G, toFun (x * y) = toFun x * toFun y

infixl:25 " ≃* " => MulEquiv

namespace MulEquiv

variable {G : Type u} {H : Type v} {K : Type w} [Group G] [Group H] [Group K]

-- `e x` goes through the underlying bijection. Tagging `toEquiv` as a coercion makes goals
-- show `↑↑e x` (inner `↑`: `G ≃* H` to `G ≃ H`, outer: `G ≃ H` to `G → H`) instead of
-- `↑e.toEquiv x`; display only, the term is unchanged. Mathlib shows `⇑e x`, via `EquivLike`.
attribute [coe] MulEquiv.toEquiv

instance : CoeFun (G ≃* H) (fun _ => G → H) := ⟨fun e => e.toEquiv⟩

theorem ext {e e' : G ≃* H} (h : ∀ x, e x = e' x) : e = e' := by
  obtain ⟨inner_equiv, _hf_mul⟩ := e
  obtain ⟨inner_equiv', _hf_mul'⟩ := e'
  have he : inner_equiv = inner_equiv' :=
    Equiv.ext h
  subst he
  rfl

-- `toEquiv` is generated by `extends`
theorem coe_toEquiv (e : G ≃* H) : (e.toEquiv : G → H) = e :=
  rfl

protected theorem map_mul (e : G ≃* H) (x y : G) : e (x * y) = e x * e y :=
  e.map_mul' x y

protected theorem map_one (e : G ≃* H) : e 1 = 1 := by
  rw [← mul_left_inj (e 1)]
  rw [← e.map_mul]
  rw [one_mul, one_mul]

protected theorem map_inv (e : G ≃* H) (x : G) : e x⁻¹ = (e x)⁻¹ := by
  apply eq_inv_of_mul_eq_one_left
  rw [← MulEquiv.map_mul]
  rw [inv_mul_cancel]
  exact MulEquiv.map_one e

def toMonoidHom (e : G ≃* H) : G →* H where
  toFun := e.toFun
  map_one' := MulEquiv.map_one e
  map_mul' := e.map_mul'

theorem coe_toMonoidHom (e : G ≃* H) : (e.toMonoidHom : G → H) = e :=
  rfl

theorem toMonoidHom_injective : Function.Injective (toMonoidHom : (G ≃* H) → (G →* H)) := by
  rintro ⟨e₁, _⟩ ⟨e₂, _⟩ heq
  have h : e₁.toFun = e₂.toFun := by
    unfold toMonoidHom  at heq
    injection heq
  apply MulEquiv.ext
  intro x
  show e₁.toFun x = e₂.toFun x
  rw [h]

/-! ### refl, symm, trans -/

protected def refl (G : Type u) [Group G] : G ≃* G where
  toEquiv := Equiv.refl G
  map_mul' := λ _ _ => rfl

-- the inverse of an isomorphism is a hom: the proof is the exercise
protected def symm (e : G ≃* H) : H ≃* G where
  toEquiv := Equiv.symm e.toEquiv
  map_mul' := by
    intro x y
    let f : G → H := e.toFun
    let fi : H → G := e.invFun
    have hr : ∀ b : H, f (fi b) = b := e.right_inv
    have hl : ∀ a : G, fi (f a) = a := e.left_inv
    have hm : ∀ (x y : G), f (x * y) = f x * f y := e.map_mul
    calc fi (x * y)
     _ = fi (f (fi x) * f (fi y)) := by rw [hr, hr]
     _ = fi (f (fi x * fi y)) := by rw [← hm]
     _ = fi x * fi y := by rw [hl]

protected def trans (e : G ≃* H) (e' : H ≃* K) : G ≃* K where
  toEquiv := Equiv.trans e.toEquiv e'.toEquiv
  map_mul' := by
    intro (x : G) (y : G)
    calc (Equiv.trans e.toEquiv e'.toEquiv).toFun (x * y)
     _ = e'.toFun (e.toFun (x * y)) := rfl
     _ = e'.toFun (e.toFun x * e.toFun y) := by rw [e.map_mul]
     _ = e'.toFun (e.toFun x) * e'.toFun (e.toFun y) := by rw [e'.map_mul]
     _ = (Equiv.trans e.toEquiv e'.toEquiv).toFun x * (Equiv.trans e.toEquiv e'.toEquiv).toFun y := rfl

theorem refl_apply (x : G) : MulEquiv.refl G x = x :=
  rfl

theorem trans_apply (e : G ≃* H) (e' : H ≃* K) (x : G) : e.trans e' x = e' (e x) :=
  rfl

theorem symm_apply_apply (e : G ≃* H) (x : G) : e.symm (e x) = x :=
  calc e.symm (e x)
   _ = (MulEquiv.symm e).toFun (e.toFun x) := rfl
   _ = e.invFun (e.toFun x) := rfl
   _ = x := by rw [e.left_inv]

theorem apply_symm_apply (e : G ≃* H) (y : H) : e (e.symm y) = y :=
  calc e (e.symm y)
   _ = e.toFun (e.invFun y) := rfl
   _ = y := by rw [e.right_inv]

theorem symm_symm (e : G ≃* H) : e.symm.symm = e :=
  rfl

theorem self_trans_symm (e : G ≃* H) : e.trans e.symm = MulEquiv.refl G := by
  apply ext
  intro (x : G)
  calc (e.trans e.symm) x
   _ = (MulEquiv.trans e e.symm) x := rfl
   _ = e.invFun (e.toFun x) := rfl
   _ = x := by rw [e.left_inv]
   _ = (MulEquiv.refl G) x := rfl

theorem symm_trans_self (e : G ≃* H) : e.symm.trans e = MulEquiv.refl H := by
  apply ext
  intro (y : H)
  calc e.symm.trans e y
   _ = (MulEquiv.trans e.symm e) y := rfl
   _ = e.toFun (e.invFun y) := rfl
   _ = y := by rw [e.right_inv]
   _ = (MulEquiv.refl H) y := rfl

theorem toMonoidHom_refl : (MulEquiv.refl G).toMonoidHom = MonoidHom.id G := by
  let auto := MulEquiv.refl G
  apply MonoidHom.ext
  intro (x : G)
  calc auto.toMonoidHom x
   _ = auto.toFun x := rfl
   _ = id x := rfl
   _ = (MonoidHom.id G) x := rfl

theorem toMonoidHom_trans (e : G ≃* H) (e' : H ≃* K) :
    (e.trans e').toMonoidHom = e'.toMonoidHom ∘* e.toMonoidHom := by
  apply MonoidHom.ext
  intro (x : G)
  calc (e.trans e').toMonoidHom x
   _ = e'.toFun (e.toFun x) := rfl
   _ = (e'.toMonoidHom ∘* e.toMonoidHom) x := rfl

protected theorem injective (e : G ≃* H) : Function.Injective e :=
  Function.LeftInverse.injective e.left_inv

protected theorem surjective (e : G ≃* H) : Function.Surjective e :=
  Function.RightInverse.surjective e.right_inv

protected theorem bijective (e : G ≃* H) : Function.Bijective e :=
  ⟨MulEquiv.injective e, MulEquiv.surjective e⟩

/-! ### A bijective hom is an isomorphism

The inverse is `Function.surjInv`, picked by choice, hence `noncomputable`. -/

noncomputable def ofBijective (f : G →* H) (hf : Function.Bijective f) : G ≃* H where
  toEquiv := Equiv.ofBijective f.toFun hf
  map_mul' := by
    intro x y
    let bij := Equiv.ofBijective f.toFun hf
    calc bij.toFun (x * y)
     _ = f (x * y) := rfl
     _ = f x * f y := by rw [f.map_mul]
     _ = bij.toFun x * bij.toFun y := rfl

theorem ofBijective_apply (f : G →* H) (hf : Function.Bijective f) (x : G) :
    ofBijective f hf x = f x :=
  rfl

end MulEquiv
end My

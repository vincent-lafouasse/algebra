import Algebra.Group.Subgroup.ZPowers

/-! # The subgroup generated by a set

Mathlib: `Mathlib/Algebra/Group/Subgroup/Lattice.lean` (`Subgroup.closure`, `closure_le`,
`closure_induction`), `Mathlib/Algebra/Group/Subgroup/ZPowers/Basic.lean`
(`zpowers_eq_closure`).

`closure s` is the smallest subgroup containing `s`. It is built *from above*: the
intersection of every subgroup that contains `s` (Mathlib: `sInf {K | s ⊆ K}`; here the
intersection is written out). That makes "smallest" easy (`closure_le`) and "what are its
elements?" hard: the answer, products of elements of `s` and their inverses, is what
`closure_induction` gives you without ever listing them.

Hints for `closure_induction` (a thinking exercise): a predicate `p` that holds on `s` and
survives `1`, `*` and `⁻¹` carves out a subgroup. Which one? Where does `closure s` sit
relative to it? -/

universe u

namespace My

namespace Subgroup

variable {G : Type u} [Group G]

-- the elements that every subgroup containing `s` contains
def closure (s : Set G) : Subgroup G where
  carrier := {x | ∀ K : Subgroup G, s ⊆ (K : Set G) → x ∈ K}
  mul_mem' := sorry
  one_mem' := sorry
  inv_mem' := sorry

-- the interface: read membership through this, not through `carrier`
-- (Mathlib proves it from `mem_sInf`)
theorem mem_closure {s : Set G} {x : G} :
    x ∈ closure s ↔ ∀ K : Subgroup G, s ⊆ (K : Set G) → x ∈ K :=
  sorry

theorem subset_closure {s : Set G} : s ⊆ (closure s : Set G) :=
  sorry

-- the universal property: `closure s` is the smallest subgroup containing `s`
theorem closure_le {s : Set G} {K : Subgroup G} : closure s ≤ K ↔ s ⊆ (K : Set G) :=
  sorry

theorem closure_mono {s t : Set G} (h : s ⊆ t) : closure s ≤ closure t :=
  sorry

-- a subgroup generates itself
theorem closure_eq (K : Subgroup G) : closure (K : Set G) = K :=
  sorry

-- To prove `p x` for every `x ∈ closure s`: check it on `s`, at `1`, and under `*` and `⁻¹`.
-- (Mathlib's `p` also takes the proof `x ∈ closure s`; this is the simpler version.)
theorem closure_induction {s : Set G} {p : G → Prop} (mem : ∀ x ∈ s, p x) (one : p 1)
    (mul : ∀ x y, p x → p y → p (x * y)) (inv : ∀ x, p x → p x⁻¹) {x : G} (hx : x ∈ closure s) :
    p x :=
  sorry

/-! ### Small sets -/

theorem closure_empty : closure (∅ : Set G) = ⊥ :=
  sorry

theorem closure_univ : closure (Set.univ : Set G) = ⊤ :=
  sorry

-- `⟨g⟩`, seen as a generated subgroup
theorem zpowers_eq_closure (g : G) : zpowers g = closure {g} :=
  sorry

end Subgroup

end My

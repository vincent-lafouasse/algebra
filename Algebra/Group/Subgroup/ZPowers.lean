import Algebra.Group.Subgroup.Lattice

/-! # The subgroup generated by one element

Mathlib: `Mathlib/Algebra/Group/Subgroup/ZPowers/Basic.lean` (and `pow_mem`/`zpow_mem` from
`Mathlib/Algebra/Group/Subgroup/Defs.lean`).

`zpowers g` is `⟨g⟩ = { g ^ k | k : Int }`, the smallest subgroup containing `g`. -/

universe u

namespace My
namespace Subgroup

variable {G : Type u} [Group G]

protected theorem pow_mem (H : Subgroup G) {x : G} (hx : x ∈ H) (n : Nat) : x ^ n ∈ H :=
  sorry

protected theorem zpow_mem (H : Subgroup G) {x : G} (hx : x ∈ H) (k : Int) : x ^ k ∈ H :=
  sorry

-- closure is `zpow_add`, `zpow_neg`, `zpow_zero`
def zpowers (g : G) : Subgroup G where
  carrier := {x | ∃ k : Int, g ^ k = x}
  mul_mem' := sorry
  one_mem' := sorry
  inv_mem' := sorry

theorem mem_zpowers_iff {g h : G} : h ∈ zpowers g ↔ ∃ k : Int, g ^ k = h :=
  sorry

theorem zpow_mem_zpowers (g : G) (k : Int) : g ^ k ∈ zpowers g :=
  sorry

theorem mem_zpowers (g : G) : g ∈ zpowers g :=
  sorry

-- ⟨g⟩ is the smallest subgroup containing g
theorem zpowers_le {g : G} {H : Subgroup G} : zpowers g ≤ H ↔ g ∈ H :=
  sorry

theorem zpowers_one_eq_bot : zpowers (1 : G) = ⊥ :=
  sorry

end Subgroup
end My

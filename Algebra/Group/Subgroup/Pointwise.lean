import Algebra.Group.Subgroup.Basic
import Algebra.Group.Pointwise.Set

/-! # `H * N`: the product of two subgroups, as a set

Mathlib: `Mathlib/Algebra/Group/Subgroup/Pointwise.lean` (`sup_eq_closure_mul`, `mul_normal`),
`Mathlib/Algebra/Group/Subgroup/Lattice.lean` (`mem_sup_of_normal_right`).

`H ⊔ K` is the subgroup generated by `H ∪ K`, whose elements are long alternating products
`h₁ k₁ h₂ k₂ ⋯`. In general that is all one can say. When one of them is normal, everything
collapses to a single `h * n`: `↑(H ⊔ N) = H * N`. This is the "`HN`" of textbook statements of
the second isomorphism theorem, which Mathlib writes `H ⊔ N`.

Hint for `mem_sup_of_normal_right` (a thinking exercise): `closure_induction`, with the
predicate "is some `y * z`, `y ∈ s`, `z ∈ t`". The product case needs `y₁ z₁ y₂ z₂` back in
that shape: what does normality let you do with `z₁ y₂`? -/

universe u

namespace My

namespace Subgroup

variable {G : Type u} [Group G]

theorem sup_eq_closure_mul (H K : Subgroup G) : H ⊔ K = closure ((H : Set G) * (K : Set G)) :=
  sorry

theorem mem_sup_of_normal_right {s t : Subgroup G} [t.Normal] {x : G} :
    x ∈ s ⊔ t ↔ ∃ y ∈ s, ∃ z ∈ t, y * z = x :=
  sorry

theorem mem_sup_of_normal_left {s t : Subgroup G} [s.Normal] {x : G} :
    x ∈ s ⊔ t ↔ ∃ y ∈ s, ∃ z ∈ t, y * z = x :=
  sorry

theorem mul_normal (H N : Subgroup G) [N.Normal] : (↑(H ⊔ N) : Set G) = (H : Set G) * N :=
  sorry

theorem normal_mul (N H : Subgroup G) [N.Normal] : (↑(N ⊔ H) : Set G) = (N : Set G) * H :=
  sorry

end Subgroup

end My
